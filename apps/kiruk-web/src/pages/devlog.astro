---
import { devlogs } from '../../.velite';
import EyeMark from '../components/sketch/EyeMark.astro';
import SketchNav from '../components/sketch/SketchNav.astro';
import Base from '../layouts/Base.astro';
import { href } from '../lib/base';

const posts = [...devlogs].sort((a, b) => (a.date < b.date ? 1 : -1));
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const excerpt = (html: string) =>
  html
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 160);
---

<Base title="devlog — kiruk" description="Building in public — process, dead ends, and revivals.">
  <main class="bg-paper text-ink relative min-h-[100svh] w-full px-6 py-20 md:px-10">
    <section class="mx-auto flex max-w-3xl flex-col gap-9 pb-28">
      <header class="flex items-center gap-3">
        <EyeMark size={48} />
        <div class="leading-none">
          <p class="handwritten text-pencil text-sm">building in public</p>
          <h1 class="font-wordmark text-6xl leading-none md:text-8xl">devlog</h1>
        </div>
      </header>

      <p class="handwritten text-2xl leading-snug md:text-3xl">
        Process on display &mdash; the passes that landed, the ones that didn&rsquo;t, the work still
        in motion.
      </p>

      {
        posts.length === 0 ? (
          <div class="sketch-border p-6">
            <p class="handwritten text-ink text-2xl">the feed is warming up.</p>
            <p class="handwritten text-pencil text-lg">First entry lands soon.</p>
          </div>
        ) : (
          <ul class="flex flex-col gap-4">
            {posts.map((p) => (
              <li>
                <a
                  href={href(p.url)}
                  class="sketch-border flex flex-col gap-2 p-5 transition-transform hover:-translate-y-0.5"
                >
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                    <span class="handwritten text-ink text-2xl">{p.title}</span>
                    <span class="handwritten text-pencil text-sm">
                      {fmt(p.date)}
                      {p.state !== 'published' ? ` · ${p.state}` : ''}
                    </span>
                  </div>
                  <p class="handwritten text-pencil text-base">{excerpt(p.body)}&hellip;</p>
                  {p.tags.length > 0 ? (
                    <div class="flex flex-wrap gap-1.5">
                      {p.tags.map((t) => (
                        <span class="handwritten text-pencil rounded border border-rule px-2 py-0.5 text-xs">
                          {t}
                        </span>
                      ))}
                    </div>
                  ) : null}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
    <SketchNav />
  </main>
</Base>
