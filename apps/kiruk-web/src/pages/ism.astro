---
import EyeMark from '../components/sketch/EyeMark.astro';
import SketchNav from '../components/sketch/SketchNav.astro';
import Base from '../layouts/Base.astro';
import { href } from '../lib/base';
---

<Base title="ism lab — kiruk" description="The ISM lab: micro-worlds kiruk builds for itself, in public.">
  <main class="bg-paper text-ink relative min-h-[100svh] w-full px-6 py-20 md:px-10">
    <section class="mx-auto flex max-w-3xl flex-col gap-9 pb-28">
      <header class="flex items-center gap-3">
        <EyeMark size={48} />
        <div class="leading-none">
          <p class="handwritten text-pencil text-sm">self-initiated experiment series</p>
          <h1 class="font-wordmark text-6xl leading-none md:text-8xl">the ism lab</h1>
        </div>
      </header>

      <p class="handwritten text-2xl leading-snug md:text-3xl">
        Micro-worlds we build for ourselves &mdash; so the edge stays sharp when the client work is
        quiet. What we learn in the lab feeds what we ship for you.
      </p>

      <div class="sketch-border flex flex-col gap-2 p-6">
        <p class="handwritten text-pencil text-sm">lab status</p>
        <p class="handwritten text-ink text-2xl">the lab is warming up.</p>
        <p class="handwritten text-pencil text-lg">
          The first ISM is being scribbled. It&rsquo;ll show up here &mdash; and in the
          <a class="text-ink underline underline-offset-2" href={href('/devlog')}>devlog</a> &mdash;
          built in public, dead ends and all.
        </p>
      </div>

      <p class="handwritten text-pencil text-lg">
        ISMs are run openly: heroism, colorism, nomadism, kirukism-series&hellip; each its own
        universe, each rooted in a scribble.
      </p>
    </section>
    <SketchNav />
  </main>
</Base>
