# kiruk-portal — environment (Slice 3: auth + DB)
# Copy to .env.local and fill in AFTER provisioning Neon. NEVER commit real values (.env* is gitignored).

# Neon Postgres connection string (Project → Connection Details → pooled, sslmode=require)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Better-Auth — generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Founder admin allowlist (comma-separated emails) — these sign in as admin.
ADMIN_EMAILS=you@example.com

# Email sender for magic links (Resend). Without RESEND_API_KEY the link is printed to the
# server console (local dev). EMAIL_FROM must be a Resend-verified sender in prod.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=kiruk <onboarding@resend.dev>

# Optional OAuth providers (Better-Auth) — leave blank to use magic-link only
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
