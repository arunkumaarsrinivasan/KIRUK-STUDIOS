{
  "color": {
    "bg": {
      "$type": "color",
      "$value": "{color.paper}",
      "$description": "Page background — white paper."
    },
    "fg": {
      "$type": "color",
      "$value": "{color.ink}",
      "$description": "Primary foreground — pen/pencil stroke."
    },
    "fg-muted": { "$type": "color", "$value": "{color.pencil-400}" },
    "surface": { "$type": "color", "$value": "{color.paper}" },
    "accent": {
      "$type": "color",
      "$value": "{color.ink}",
      "$description": "UI accent stays mono (ink). Absurd color is asset-only."
    },
    "accent-alt": { "$type": "color", "$value": "{color.pencil-500}" },
    "halo": { "$type": "color", "$value": "{color.pencil-200}" },
    "border": { "$type": "color", "$value": "{color.ink}" }
  },
  "space": {
    "inline-xs": { "$type": "dimension", "$value": "{dimension.space.2}" },
    "inline-sm": { "$type": "dimension", "$value": "{dimension.space.3}" },
    "inline-md": { "$type": "dimension", "$value": "{dimension.space.4}" },
    "inline-lg": { "$type": "dimension", "$value": "{dimension.space.5}" },
    "stack-xs": { "$type": "dimension", "$value": "{dimension.space.3}" },
    "stack-sm": { "$type": "dimension", "$value": "{dimension.space.4}" },
    "stack-md": { "$type": "dimension", "$value": "{dimension.space.6}" },
    "stack-lg": { "$type": "dimension", "$value": "{dimension.space.8}" }
  }
}
