{
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "The page. White paper — the unwritten universe."
    },
    "ink": {
      "$type": "color",
      "$value": "#0A0A0A",
      "$description": "Pen/pencil stroke — primary foreground line."
    },
    "pencil-100": {
      "$type": "color",
      "$value": "#E5E5E5",
      "$description": "Pencil ramp — faintest graphite."
    },
    "pencil-200": { "$type": "color", "$value": "#C9C9C9", "$description": "Pencil ramp." },
    "pencil-300": {
      "$type": "color",
      "$value": "#9A9A9A",
      "$description": "Pencil ramp — muted line."
    },
    "pencil-400": {
      "$type": "color",
      "$value": "#6B6B6B",
      "$description": "Pencil ramp — mid graphite."
    },
    "pencil-500": {
      "$type": "color",
      "$value": "#3A3A3A",
      "$description": "Pencil ramp — heavy graphite."
    },
    "pencil-600": {
      "$type": "color",
      "$value": "#1A1A1A",
      "$description": "Pencil ramp — near-black, strong stroke."
    },
    "absurd": {
      "pink": {
        "$type": "color",
        "$value": "#FF2D78",
        "$description": "Absurd asset color — illustrations/objects only, never UI chrome."
      },
      "lime": {
        "$type": "color",
        "$value": "#B6FF1A",
        "$description": "Absurd asset color — assets only."
      },
      "violet": {
        "$type": "color",
        "$value": "#7C4DFF",
        "$description": "Absurd asset color — assets only."
      },
      "cyan": {
        "$type": "color",
        "$value": "#18E0FF",
        "$description": "Absurd asset color — assets only."
      },
      "orange": {
        "$type": "color",
        "$value": "#FF6A00",
        "$description": "Absurd asset color — assets only."
      }
    }
  },
  "dimension": {
    "space": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "24px" },
      "6": { "$type": "dimension", "$value": "32px" },
      "7": { "$type": "dimension", "$value": "48px" },
      "8": { "$type": "dimension", "$value": "64px" },
      "9": { "$type": "dimension", "$value": "96px" }
    }
  },
  "fontFamily": {
    "wordmark": {
      "$type": "fontFamily",
      "$value": "Bridges Not Walls, cursive",
      "$description": "KIRUK wordmark face (placeholder until custom letterform — B2)."
    },
    "display": {
      "$type": "fontFamily",
      "$value": "Magnetic Drawing, cursive",
      "$description": "Hand-drawn display face — big headings."
    },
    "handwriting": {
      "$type": "fontFamily",
      "$value": "Left Hand, cursive",
      "$description": "Handwriting face — notes, labels, accents."
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Inter, ui-sans-serif, system-ui, sans-serif",
      "$description": "Clean body sans — long-form reading + UI."
    },
    "mono": { "$type": "fontFamily", "$value": "JetBrains Mono, ui-monospace, monospace" }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "duration": {
    "instant": { "$type": "duration", "$value": "80ms" },
    "fast": { "$type": "duration", "$value": "180ms" },
    "base": { "$type": "duration", "$value": "280ms" },
    "slow": { "$type": "duration", "$value": "520ms" },
    "portal": {
      "$type": "duration",
      "$value": "900ms",
      "$description": "Between-universe transition."
    }
  },
  "cubicBezier": {
    "ease-gaze": {
      "$type": "cubicBezier",
      "$value": [0.2, 0.8, 0.2, 1],
      "$description": "Gaze-tracking smoothness."
    },
    "ease-iris": {
      "$type": "cubicBezier",
      "$value": [0.65, 0, 0.35, 1],
      "$description": "Iris dilation — quick-out, settle."
    },
    "ease-portal": {
      "$type": "cubicBezier",
      "$value": [0.87, 0, 0.13, 1],
      "$description": "Portal collapse/expand."
    }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "iris": { "$type": "dimension", "$value": "9999px", "$description": "Full round — iris shape." }
  }
}
